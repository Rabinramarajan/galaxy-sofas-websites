{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ],
        "versionedFiles": [
          "/**/*.css",
          "/**/*.js",
          "/**/*.woff2"
        ]
      },
      "updateMode": "prefetch"
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/images/**",
          "/*.webp",
          "/*.avif",
          "/*.svg",
          "/*.png",
          "/*.jpg",
          "/*.jpeg"
        ],
        "urls": [
          "https://images.unsplash.com/**",
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    },
    {
      "name": "fonts",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/fonts/**"
        ],
        "urls": [
          "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-products",
      "urls": [
        "/api/products/**",
        "/api/categories/**",
        "/api/collections/**"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "1d",
        "strategy": "freshness",
        "timeout": "10s"
      }
    },
    {
      "name": "api-content",
      "urls": [
        "/api/blog/**",
        "/api/testimonials/**",
        "/api/faqs/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "1h",
        "strategy": "performance"
      }
    },
    {
      "name": "unsplash-images",
      "urls": [
        "https://images.unsplash.com/**"
      ],
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "30d",
        "strategy": "performance"
      }
    }
  ],
  "navigationUrls": [
    "/**"
  ],
  "navigationRequestStrategy": "freshness"
}